#!/bin/sh
# Gate de mensagem de commit: a funcao do commitlint SEM dependencia nova para a logica
# (husky so dispara o hook). O git passa o caminho do arquivo de mensagem em $1; o padrao
# cobrado e o de commitlint.config.js (ver scripts/ci/commit-msg-lint.mjs).
node scripts/ci/commit-msg-lint.mjs "$1"
