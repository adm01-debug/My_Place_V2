{
  "name": "MY-PLACE Portal do Colaborador",
  "short_name": "MY-PLACE",
  "description": "Portal do Colaborador - Gestão de RH, Ponto, Férias, Holerites e mais",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#3b82f6",
  "scope": "/",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  
  "icons": [
    {
      "src": "/pwa-64x64.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Registrar Ponto",
      "short_name": "Ponto",
      "description": "Registrar entrada ou saída",
      "url": "/ponto",
      "icons": [{ "src": "/icons/clock.png", "sizes": "96x96" }]
    },
    {
      "name": "Ver Holerites",
      "short_name": "Holerites",
      "description": "Consultar holerites",
      "url": "/holerites",
      "icons": [{ "src": "/icons/document.png", "sizes": "96x96" }]
    },
    {
      "name": "Solicitar Férias",
      "short_name": "Férias",
      "description": "Solicitar período de férias",
      "url": "/ferias",
      "icons": [{ "src": "/icons/calendar.png", "sizes": "96x96" }]
    },
    {
      "name": "Notificações",
      "short_name": "Alertas",
      "description": "Ver notificações",
      "url": "/notificacoes",
      "icons": [{ "src": "/icons/bell.png", "sizes": "96x96" }]
    }
  ],

  "screenshots": [
    {
      "src": "/screenshots/dashboard-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard principal"
    },
    {
      "src": "/screenshots/dashboard-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard mobile"
    },
    {
      "src": "/screenshots/ponto-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Registro de ponto"
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "documents",
          "accept": ["application/pdf", "image/*"]
        }
      ]
    }
  },

  "protocol_handlers": [
    {
      "protocol": "web+myplace",
      "url": "/%s"
    }
  ],

  "file_handlers": [
    {
      "action": "/documentos/upload",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".jpg", ".jpeg", ".png", ".gif"]
      }
    }
  ],

  "handle_links": "preferred",

  "edge_side_panel": {
    "preferred_width": 400
  },

  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },

  "related_applications": [],
  "prefer_related_applications": false
}
